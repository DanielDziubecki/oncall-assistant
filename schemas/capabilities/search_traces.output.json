{
  "$defs": {
    "ErrorSpan": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "service": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "service",
        "operation"
      ],
      "title": "ErrorSpan",
      "type": "object"
    },
    "TraceSummary": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "error_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The deepest span with error status, if any."
        },
        "ref": {
          "description": "Citation of one item in a recorded tool result: e<event_id>#<index>.",
          "examples": [
            "e42#3"
          ],
          "pattern": "^e([1-9]\\d*)#(\\d+)$",
          "title": "Ref",
          "type": "string"
        },
        "root_operation": {
          "title": "Root Operation",
          "type": "string"
        },
        "root_service": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Root Service",
          "type": "string"
        },
        "span_count": {
          "minimum": 1,
          "title": "Span Count",
          "type": "integer"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "trace_id": {
          "description": "W3C trace id, 32 hex.",
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "trace_id",
        "root_service",
        "root_operation",
        "start",
        "duration_ms",
        "span_count"
      ],
      "title": "TraceSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "traces": {
      "items": {
        "$ref": "#/$defs/TraceSummary"
      },
      "title": "Traces",
      "type": "array"
    },
    "truncated": {
      "default": false,
      "description": "True when the backend had more items than were returned.",
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "traces"
  ],
  "title": "SearchTracesOutput",
  "type": "object"
}
