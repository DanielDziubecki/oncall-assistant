{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "description": "A claim tied to one recorded tool result item, with a value the verifier can check.",
      "properties": {
        "claim": {
          "description": "What this item shows, in one sentence.",
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "quote": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact text from the item: a trace id, span id or log substring.",
          "title": "Quote"
        },
        "ref": {
          "description": "Citation of one item in a recorded tool result: e<event_id>#<index>.",
          "examples": [
            "e42#3"
          ],
          "pattern": "^e([1-9]\\d*)#(\\d+)$",
          "title": "Ref",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A number from the item, e.g. a metric value or error ratio.",
          "title": "Value"
        }
      },
      "required": [
        "ref",
        "kind",
        "claim"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "alert",
        "metric",
        "trace",
        "log",
        "resource"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "FaultType": {
      "enum": [
        "dependency_unreachable",
        "network_latency",
        "packet_loss",
        "application_error",
        "memory_leak",
        "cpu_saturation",
        "slow_consumer",
        "bad_config_deploy",
        "traffic_surge",
        "none"
      ],
      "title": "FaultType",
      "type": "string"
    },
    "ProposedFix": {
      "additionalProperties": false,
      "description": "Advisory only: a human approves or rejects it, nothing is executed.",
      "properties": {
        "risk": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "title": "ProposedFix",
      "type": "object"
    },
    "RootCause": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*(->[A-Za-z0-9][A-Za-z0-9_.\\-]*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "None only when fault_type is none.",
          "title": "Component"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fault_type": {
          "$ref": "#/$defs/FaultType"
        },
        "mechanism": {
          "description": "How the fault produces the symptoms.",
          "minLength": 1,
          "title": "Mechanism",
          "type": "string"
        }
      },
      "required": [
        "component",
        "fault_type",
        "mechanism",
        "confidence",
        "evidence"
      ],
      "title": "RootCause",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "proposed_fix": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProposedFix"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "root_causes": {
      "description": "Most likely first; scored as top-1 and top-3.",
      "items": {
        "$ref": "#/$defs/RootCause"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Root Causes",
      "type": "array"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "unchecked": {
      "description": "What could not be checked (tool errors, missing access) and why.",
      "items": {
        "type": "string"
      },
      "title": "Unchecked",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "root_causes"
  ],
  "title": "Diagnosis",
  "type": "object"
}
